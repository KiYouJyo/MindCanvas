<Window
    x:Class="MindCanvas.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource V4WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="40" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource V4TitleBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource MindCanvasAccentBrush}" />
                <TextBlock Text="MindCanvas" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource V4TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <controls:TabView
                x:Name="DocumentTabs"
                Grid.Column="1"
                Height="32"
                Margin="23,8,150,0"
                VerticalAlignment="Top"
                Background="Transparent"
                AddTabButtonClick="DocumentTabs_AddTabButtonClick"
                TabCloseRequested="DocumentTabs_TabCloseRequested"
                SelectionChanged="DocumentTabs_SelectionChanged" />
        </Grid>

        <Grid Grid.Row="1">
            <Border
                x:Name="ContextIdentity"
                Background="{ThemeResource V4ContextIdentityBackgroundBrush}"
                BorderBrush="{ThemeResource V4DividerBrush}"
                BorderThickness="0,0,0,1">
                <Grid Padding="174,0,51,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <TextBlock x:Name="ContextTitle" FontSize="16" FontWeight="Medium" Foreground="{ThemeResource V4TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ContextSubtitle" FontSize="12" Foreground="{ThemeResource V4TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel
                        x:Name="EditorViewSelector"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="4"
                        Visibility="Collapsed">
                        <ToggleButton x:Name="ViewMap" Style="{ThemeResource V4EditorViewButtonStyle}" IsChecked="False" Click="ViewMode_Click" Tag="map" />
                        <ToggleButton x:Name="ViewOutline" Style="{ThemeResource V4EditorViewButtonStyle}" IsChecked="False" Click="ViewMode_Click" Tag="outline" />
                        <ToggleButton x:Name="ViewSplit" Style="{ThemeResource V4EditorViewButtonStyle}" IsChecked="True" Click="ViewMode_Click" Tag="split" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                x:Name="EditorCategoryBar"
                Background="{ThemeResource V4ContextIdentityBackgroundBrush}"
                BorderBrush="{ThemeResource V4DividerBrush}"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
                <Grid Padding="174,0,51,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
                        <ToggleButton x:Name="EditorCategoryStart" Style="{ThemeResource V4EditorCategoryButtonStyle}" IsChecked="True" Click="EditorCategory_Click" Tag="start" />
                        <ToggleButton x:Name="EditorCategoryInsert" Style="{ThemeResource V4EditorCategoryButtonStyle}" Click="EditorCategory_Click" Tag="insert" />
                        <ToggleButton x:Name="EditorCategoryStyle" Style="{ThemeResource V4EditorCategoryButtonStyle}" Click="EditorCategory_Click" Tag="style" />
                        <ToggleButton x:Name="EditorCategoryView" Style="{ThemeResource V4EditorCategoryButtonStyle}" Click="EditorCategory_Click" Tag="view" />
                        <ToggleButton x:Name="EditorCategoryTools" Style="{ThemeResource V4EditorCategoryButtonStyle}" Click="EditorCategory_Click" Tag="tools" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <ToggleButton x:Name="EditorViewMap" Style="{ThemeResource V4EditorViewButtonStyle}" IsChecked="False" Click="ViewMode_Click" Tag="map" />
                        <ToggleButton x:Name="EditorViewOutline" Style="{ThemeResource V4EditorViewButtonStyle}" IsChecked="False" Click="ViewMode_Click" Tag="outline" />
                        <ToggleButton x:Name="EditorViewSplit" Style="{ThemeResource V4EditorViewButtonStyle}" IsChecked="True" Click="ViewMode_Click" Tag="split" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Border
                x:Name="ContextActions"
                Background="{ThemeResource V4ContextActionsBackgroundBrush}"
                BorderBrush="{ThemeResource V4DividerBrush}"
                BorderThickness="0,0,0,1">
                <Grid Padding="174,0,51,0">
                    <StackPanel x:Name="HomeActions" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <Button x:Name="HomeNewMapButton" Height="32" MinWidth="126" Background="{ThemeResource V4ControlSelectedBackgroundBrush}" BorderBrush="{ThemeResource V4ControlSelectedStrokeBrush}" Foreground="{ThemeResource V4ControlSelectedForegroundBrush}" Click="NewDocument_Click" />
                        <Button x:Name="HomeFromTemplateButton" Height="32" MinWidth="142" Background="{ThemeResource V4ControlBackgroundBrush}" BorderBrush="{ThemeResource V4ControlStrokeBrush}" Foreground="{ThemeResource V4TextPrimaryBrush}" Click="FromTemplate_Click" />
                        <Button x:Name="HomeImportButton" Height="32" MinWidth="90" Background="{ThemeResource V4ControlBackgroundBrush}" BorderBrush="{ThemeResource V4ControlStrokeBrush}" Foreground="{ThemeResource V4TextPrimaryBrush}" Click="OpenDocument_Click" />
                    </StackPanel>

                    <Grid x:Name="DocumentsActions" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DocumentsSearchBox" Width="380" Height="32" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{ThemeResource V4ControlBackgroundBrush}" BorderBrush="{ThemeResource V4ControlStrokeBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <ToggleButton x:Name="DocumentsListButton" Width="76" Height="32" IsChecked="True" Background="{ThemeResource V4ControlSelectedBackgroundBrush}" BorderBrush="{ThemeResource V4ControlSelectedStrokeBrush}" Foreground="{ThemeResource V4ControlSelectedForegroundBrush}" />
                            <ToggleButton x:Name="DocumentsGridButton" Width="76" Height="32" Background="{ThemeResource V4ControlBackgroundBrush}" BorderBrush="{ThemeResource V4ControlStrokeBrush}" Foreground="{ThemeResource V4TextPrimaryBrush}" />
                            <Button x:Name="DocumentsNewFolderButton" MinWidth="126" Height="32" Background="{ThemeResource V4ControlBackgroundBrush}" BorderBrush="{ThemeResource V4ControlStrokeBrush}" Foreground="{ThemeResource V4TextPrimaryBrush}" />
                            <Button x:Name="DocumentsNewMapButton" MinWidth="138" Height="32" Background="{ThemeResource V4ControlSelectedBackgroundBrush}" BorderBrush="{ThemeResource V4ControlSelectedStrokeBrush}" Foreground="{ThemeResource V4ControlSelectedForegroundBrush}" Click="NewDocument_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="TemplatesActions" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <ToggleButton x:Name="TemplatesRecommendedButton" Width="96" Height="32" IsChecked="True" Background="{ThemeResource V4ControlSelectedBackgroundBrush}" BorderBrush="{ThemeResource V4ControlSelectedStrokeBrush}" Foreground="{ThemeResource V4ControlSelectedForegroundBrush}" />
                            <ToggleButton x:Name="TemplatesAllButton" Width="96" Height="32" Background="{ThemeResource V4ControlBackgroundBrush}" BorderBrush="{ThemeResource V4ControlStrokeBrush}" Foreground="{ThemeResource V4TextPrimaryBrush}" />
                            <ToggleButton x:Name="TemplatesFavoritesButton" Width="96" Height="32" Background="{ThemeResource V4ControlBackgroundBrush}" BorderBrush="{ThemeResource V4ControlStrokeBrush}" Foreground="{ThemeResource V4TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBox x:Name="TemplatesSearchBox" Grid.Column="1" Width="404" Height="32" VerticalAlignment="Center" Background="{ThemeResource V4ControlBackgroundBrush}" BorderBrush="{ThemeResource V4CardStrokeBrush}" />
                    </Grid>

                    <Grid x:Name="SettingsActions" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SettingsSearchBox" Width="420" Height="38" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{ThemeResource V4ControlBackgroundBrush}" BorderBrush="{ThemeResource V4DividerStrongBrush}" />
                        <Button x:Name="SettingsResetButton" Grid.Column="1" Width="144" Height="32" VerticalAlignment="Center" Background="{ThemeResource V4ControlBackgroundBrush}" BorderBrush="{ThemeResource V4ControlStrokeBrush}" Foreground="{ThemeResource V4TextPrimaryBrush}" Click="SettingsResetButton_Click" />
                    </Grid>

                    <controls:CommandBar
                        x:Name="EditorActions"
                        HorizontalAlignment="Right"
                        DefaultLabelPosition="Right"
                        Background="Transparent"
                        Visibility="Collapsed">
                        <controls:AppBarButton x:Uid="CommandNew" Icon="Add" Click="NewDocument_Click" />
                        <controls:AppBarButton x:Uid="CommandOpen" Icon="OpenFile" Click="OpenDocument_Click" />
                        <controls:AppBarButton x:Uid="CommandSave" Icon="Save" Click="SaveDocument_Click" />
                        <controls:AppBarButton x:Uid="CommandSaveAs" Icon="Save" Click="SaveAsDocument_Click" />
                        <controls:AppBarSeparator />
                        <controls:AppBarButton x:Uid="CommandAddChild" Icon="AddFriend" Click="AddChild_Click" />
                        <controls:AppBarButton x:Uid="CommandUndo" Icon="Undo" Click="Undo_Click" />
                        <controls:AppBarButton x:Uid="CommandRedo" Icon="Redo" Click="Redo_Click" />
                    </controls:CommandBar>
                </Grid>
            </Border>

            <Border
                x:Name="EditorCommandBar"
                Background="{ThemeResource V4ContextActionsBackgroundBrush}"
                BorderBrush="{ThemeResource V4DividerBrush}"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
                <Grid Padding="174,0,51,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <Button x:Name="EditorNewTopicButton" Height="40" MinWidth="82" Click="EditorNewTopic_Click" />
                        <Button x:Name="EditorSubtopicButton" Height="40" MinWidth="82" Click="EditorSubtopic_Click" />
                        <Button x:Name="EditorSiblingButton" Height="40" MinWidth="82" Click="EditorSibling_Click" />
                        <Button x:Name="EditorDeleteButton" Height="40" MinWidth="82" Click="EditorDelete_Click" />
                        <Button x:Name="EditorCollapseButton" Height="40" MinWidth="82" Click="EditorCollapse_Click" />
                        <Button x:Name="EditorExpandButton" Height="40" MinWidth="82" Click="EditorExpand_Click" />
                        <Button x:Name="EditorUndoButton" Height="40" MinWidth="82" Click="Undo_Click" />
                        <Button x:Name="EditorRedoButton" Height="40" MinWidth="82" Click="Redo_Click" />
                    </StackPanel>
                    <Button x:Name="EditorFormatToggleButton" Grid.Column="1" Height="40" MinWidth="90" Click="EditorFormatToggle_Click" />
                </Grid>
            </Border>
        </Grid>

        <controls:NavigationView
            x:Name="RootNavigation"
            Grid.Row="3"
            Background="{ThemeResource V4NavigationBackgroundBrush}"
            PaneDisplayMode="Left"
            OpenPaneLength="150"
            CompactPaneLength="48"
            IsPaneOpen="True"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            AlwaysShowHeader="False"
            SelectionChanged="RootNavigation_SelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem x:Uid="NavHome" Tag="home">
                    <controls:NavigationViewItem.Icon><controls:FontIcon Glyph="&#xE80F;" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Uid="NavDocuments" Tag="documents">
                    <controls:NavigationViewItem.Icon><controls:FontIcon Glyph="&#xE8A5;" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Uid="NavTemplates" Tag="templates">
                    <controls:NavigationViewItem.Icon><controls:FontIcon Glyph="&#xECA5;" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>
            <controls:NavigationView.FooterMenuItems>
                <controls:NavigationViewItem x:Uid="NavSettings" Tag="settings">
                    <controls:NavigationViewItem.Icon><controls:FontIcon Glyph="&#xE713;" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.FooterMenuItems>
            <Frame x:Name="RootFrame" />
        </controls:NavigationView>
    </Grid>
</Window>
