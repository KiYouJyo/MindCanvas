<Window
    x:Class="MindCanvas.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0" Spacing="10">
                <Border Width="20" Height="20" CornerRadius="5" Background="#0078D4"/>
                <TextBlock Text="MindCanvas" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <controls:TabView
                x:Name="DocumentTabs"
                Grid.Column="1"
                Height="40"
                Margin="23,7,150,0"
                VerticalAlignment="Top"
                Background="Transparent"
                AddTabButtonClick="DocumentTabs_AddTabButtonClick"
                TabCloseRequested="DocumentTabs_TabCloseRequested"
                SelectionChanged="DocumentTabs_SelectionChanged"/>
        </Grid>

        <Border Grid.Row="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,1"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid Padding="173,0,51,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="18">
                    <TextBlock x:Name="ContextTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ContextSubtitle"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="EditorViewSelector"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="4"
                            Visibility="Collapsed">
                    <ToggleButton x:Uid="ViewMap" MinWidth="80" Height="32"/>
                    <ToggleButton x:Uid="ViewOutline" MinWidth="80" Height="32"/>
                    <ToggleButton x:Uid="ViewSplit" MinWidth="80" Height="32" IsChecked="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid Padding="173,0,51,0">
                <StackPanel x:Name="HomeActions"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Button x:Name="HomeNewMapButton" Height="32" MinWidth="126" Click="NewDocument_Click"/>
                    <Button x:Name="HomeFromTemplateButton" Height="32" MinWidth="142" Click="FromTemplate_Click"/>
                    <Button x:Name="HomeImportButton" Height="32" MinWidth="90" Click="OpenDocument_Click"/>
                </StackPanel>

                <Grid x:Name="DocumentsActions" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DocumentsSearchBox"
                             Width="380"
                             Height="32"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <ToggleButton x:Name="DocumentsListButton" Width="76" Height="32" IsChecked="True"/>
                        <ToggleButton x:Name="DocumentsGridButton" Width="76" Height="32"/>
                        <Button x:Name="DocumentsNewFolderButton" MinWidth="126" Height="32"/>
                        <Button x:Name="DocumentsNewMapButton" MinWidth="138" Height="32" Click="NewDocument_Click"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="TemplatesActions" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <ToggleButton x:Name="TemplatesRecommendedButton" Width="96" Height="32" IsChecked="True"/>
                        <ToggleButton x:Name="TemplatesAllButton" Width="96" Height="32"/>
                        <ToggleButton x:Name="TemplatesFavoritesButton" Width="96" Height="32"/>
                    </StackPanel>
                    <TextBox x:Name="TemplatesSearchBox"
                             Grid.Column="1"
                             Width="404"
                             Height="32"
                             VerticalAlignment="Center"/>
                </Grid>

                <Grid x:Name="SettingsActions" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SettingsSearchBox"
                             Width="420"
                             Height="32"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"/>
                    <Button x:Name="SettingsResetButton"
                            Grid.Column="1"
                            Width="144"
                            Height="32"
                            VerticalAlignment="Center"
                            Click="SettingsResetButton_Click"/>
                </Grid>

                <CommandBar x:Name="EditorActions"
                            HorizontalAlignment="Right"
                            DefaultLabelPosition="Right"
                            IsOpen="False"
                            Background="Transparent"
                            Visibility="Collapsed">
                    <AppBarButton x:Uid="CommandNew" Icon="Add" Click="NewDocument_Click"/>
                    <AppBarButton x:Uid="CommandOpen" Icon="OpenFile" Click="OpenDocument_Click"/>
                    <AppBarButton x:Uid="CommandSave" Icon="Save" Click="SaveDocument_Click"/>
                    <AppBarButton x:Uid="CommandSaveAs" Icon="Save" Click="SaveAsDocument_Click"/>
                    <AppBarSeparator/>
                    <AppBarButton x:Uid="CommandAddChild" Icon="AddFriend" Click="AddChild_Click"/>
                    <AppBarButton x:Uid="CommandUndo" Icon="Undo" Click="Undo_Click"/>
                    <AppBarButton x:Uid="CommandRedo" Icon="Redo" Click="Redo_Click"/>
                </CommandBar>
            </Grid>
        </Border>

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="3"
            Background="Transparent"
            PaneDisplayMode="Left"
            OpenPaneLength="150"
            CompactPaneLength="48"
            IsPaneOpen="True"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            AlwaysShowHeader="False"
            SelectionChanged="RootNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavHome" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavDocuments" Tag="documents">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavTemplates" Tag="templates">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xECA5;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavSettings" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="RootFrame"/>
        </NavigationView>
    </Grid>
</Window>
