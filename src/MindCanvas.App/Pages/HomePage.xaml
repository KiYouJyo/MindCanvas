<Page x:Class="MindCanvas.Pages.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Padding="34,26" Spacing="28">
        <StackPanel Spacing="8"><TextBlock x:Uid="HomeRecentTitle" Style="{ThemeResource SubtitleTextBlockStyle}"/><ItemsRepeater><ItemsRepeater.ItemsSource><x:Array Type="x:String"><x:String>Product launch plan</x:String><x:String>Research plan</x:String><x:String>Study notes</x:String></x:Array></ItemsRepeater.ItemsSource><ItemsRepeater.ItemTemplate><DataTemplate><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,4"><TextBlock Text="{Binding}" FontWeight="SemiBold"/></Border></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater></StackPanel>
        <StackPanel Spacing="8"><TextBlock x:Uid="HomeQuickStartTitle" Style="{ThemeResource SubtitleTextBlockStyle}"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Height="150" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16"><TextBlock x:Uid="TemplateMindMap" FontWeight="SemiBold" VerticalAlignment="Bottom"/></Border><Border Grid.Column="1" Height="150" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16"><TextBlock x:Uid="TemplateLogic" FontWeight="SemiBold" VerticalAlignment="Bottom"/></Border><Border Grid.Column="2" Height="150" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16"><TextBlock x:Uid="TemplateTree" FontWeight="SemiBold" VerticalAlignment="Bottom"/></Border><Border Grid.Column="3" Height="150" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16"><TextBlock x:Uid="TemplateOrg" FontWeight="SemiBold" VerticalAlignment="Bottom"/></Border></Grid></StackPanel>
    </StackPanel></ScrollViewer>
</Page>
