<Page x:Class="MindCanvas.Pages.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer><StackPanel Padding="34,26" Spacing="30">
<StackPanel Spacing="10"><TextBlock x:Uid="HomeRecentTitle" Style="{ThemeResource SubtitleTextBlockStyle}"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel><TextBlock Text="Product launch plan" FontWeight="SemiBold"/><TextBlock Text="9 topics" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border><Border Grid.Column="1" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel><TextBlock Text="Research plan" FontWeight="SemiBold"/><TextBlock Text="12 topics" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border><Border Grid.Column="2" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel><TextBlock Text="Study notes" FontWeight="SemiBold"/><TextBlock Text="17 topics" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border></Grid></StackPanel>
<StackPanel Spacing="10"><TextBlock x:Uid="HomeQuickStartTitle" Style="{ThemeResource SubtitleTextBlockStyle}"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Height="160" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16"><TextBlock x:Uid="TemplateMindMap" FontWeight="SemiBold" VerticalAlignment="Bottom"/></Border><Border Grid.Column="1" Height="160" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16"><TextBlock x:Uid="TemplateLogic" FontWeight="SemiBold" VerticalAlignment="Bottom"/></Border><Border Grid.Column="2" Height="160" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16"><TextBlock x:Uid="TemplateTree" FontWeight="SemiBold" VerticalAlignment="Bottom"/></Border><Border Grid.Column="3" Height="160" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16"><TextBlock x:Uid="TemplateOrg" FontWeight="SemiBold" VerticalAlignment="Bottom"/></Border></Grid></StackPanel>
</StackPanel></ScrollViewer></Page>
