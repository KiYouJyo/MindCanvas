<Page
    x:Class="MindCanvas.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="34,34,50,40" Spacing="32" MaxWidth="1206" HorizontalAlignment="Left">
            <StackPanel Spacing="10">
                <Grid>
                    <TextBlock x:Name="RecentHeading" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource V4TextStrongBrush}" />
                    <TextBlock x:Name="ViewAllText" HorizontalAlignment="Right" Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource V4AccentBrush}" />
                </Grid>
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="288" />
                        <ColumnDefinition Width="288" />
                        <ColumnDefinition Width="288" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="72" CornerRadius="8" Padding="16,12"
                            Background="{StaticResource V4CardBackgroundBrush}"
                            BorderBrush="{StaticResource V4CardStrokeBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource V4AccentBrush}" CornerRadius="2" Margin="-16,-12,0,-12"/>
                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{StaticResource V4AccentSubtleBrush}" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="Recent1Title" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource V4TextStrongBrush}"/>
                                <TextBlock x:Name="Recent1Meta" FontSize="12" Foreground="{StaticResource V4TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="⋯" FontSize="18" Foreground="{StaticResource V4TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Height="72" CornerRadius="8" Padding="16,12"
                            Background="{StaticResource V4CardBackgroundBrush}"
                            BorderBrush="{StaticResource V4CardStrokeBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                            <Border Background="#59B063" CornerRadius="2" Margin="-16,-12,0,-12"/>
                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{StaticResource V4AccentSubtleBrush}" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="Recent2Title" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource V4TextStrongBrush}"/>
                                <TextBlock x:Name="Recent2Meta" FontSize="12" Foreground="{StaticResource V4TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="⋯" FontSize="18" Foreground="{StaticResource V4TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Height="72" CornerRadius="8" Padding="16,12"
                            Background="{StaticResource V4CardBackgroundBrush}"
                            BorderBrush="{StaticResource V4CardStrokeBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                            <Border Background="#F29C29" CornerRadius="2" Margin="-16,-12,0,-12"/>
                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{StaticResource V4AccentSubtleBrush}" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="Recent3Title" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource V4TextStrongBrush}"/>
                                <TextBlock x:Name="Recent3Meta" FontSize="12" Foreground="{StaticResource V4TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="⋯" FontSize="18" Foreground="{StaticResource V4TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Height="72" CornerRadius="8" Padding="16,12"
                            Background="{StaticResource V4CardBackgroundBrush}"
                            BorderBrush="{StaticResource V4CardStrokeBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                            <Border Background="#9E54DB" CornerRadius="2" Margin="-16,-12,0,-12"/>
                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{StaticResource V4AccentSubtleBrush}" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="Recent4Title" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource V4TextStrongBrush}"/>
                                <TextBlock x:Name="Recent4Meta" FontSize="12" Foreground="{StaticResource V4TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="⋯" FontSize="18" Foreground="{StaticResource V4TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock x:Name="QuickHeading" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource V4TextStrongBrush}"/>
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="288"/>
                        <ColumnDefinition Width="288"/>
                        <ColumnDefinition Width="288"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="178" CornerRadius="8" Padding="11"
                            Background="{StaticResource V4CardBackgroundBrush}"
                            BorderBrush="{StaticResource V4CardStrokeBrush}" BorderThickness="1">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Background="{StaticResource V4PreviewBackgroundBrush}">
                                <Border Width="56" Height="24" Background="{StaticResource V4AccentBrush}" CornerRadius="7"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Spacing="3">
                                <TextBlock x:Name="Quick1Title" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource V4TextStrongBrush}"/>
                                <TextBlock x:Name="Quick1Description" FontSize="12" Foreground="{StaticResource V4TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Height="178" CornerRadius="8" Padding="11"
                            Background="{StaticResource V4CardBackgroundBrush}"
                            BorderBrush="{StaticResource V4CardStrokeBrush}" BorderThickness="1">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Background="{StaticResource V4PreviewBackgroundBrush}">
                                <Border Width="56" Height="24" Background="#59B063" CornerRadius="7"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Spacing="3">
                                <TextBlock x:Name="Quick2Title" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource V4TextStrongBrush}"/>
                                <TextBlock x:Name="Quick2Description" FontSize="12" Foreground="{StaticResource V4TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Height="178" CornerRadius="8" Padding="11"
                            Background="{StaticResource V4CardBackgroundBrush}"
                            BorderBrush="{StaticResource V4CardStrokeBrush}" BorderThickness="1">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Background="{StaticResource V4PreviewBackgroundBrush}">
                                <Border Width="56" Height="24" Background="#F29C29" CornerRadius="7"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Spacing="3">
                                <TextBlock x:Name="Quick3Title" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource V4TextStrongBrush}"/>
                                <TextBlock x:Name="Quick3Description" FontSize="12" Foreground="{StaticResource V4TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Height="178" CornerRadius="8" Padding="11"
                            Background="{StaticResource V4CardBackgroundBrush}"
                            BorderBrush="{StaticResource V4CardStrokeBrush}" BorderThickness="1">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Background="{StaticResource V4PreviewBackgroundBrush}">
                                <Border Width="56" Height="24" Background="#9E54DB" CornerRadius="7"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Spacing="3">
                                <TextBlock x:Name="Quick4Title" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource V4TextStrongBrush}"/>
                                <TextBlock x:Name="Quick4Description" FontSize="12" Foreground="{StaticResource V4TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock x:Name="RecommendedHeading" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource V4TextStrongBrush}"/>
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="288"/>
                        <ColumnDefinition Width="288"/>
                        <ColumnDefinition Width="288"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="178" CornerRadius="8" Padding="11" Background="{StaticResource V4CardBackgroundBrush}" BorderBrush="{StaticResource V4CardStrokeBrush}" BorderThickness="1">
                        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Background="{StaticResource V4PreviewBackgroundBrush}">
                                <Border Width="56" Height="24" Background="{StaticResource V4AccentBrush}" CornerRadius="7"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Spacing="3"><Grid><TextBlock x:Name="Rec1Title" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource V4TextStrongBrush}"/><TextBlock Text="★" HorizontalAlignment="Right" Foreground="{StaticResource V4StarBrush}"/></Grid><TextBlock x:Name="Rec1Description" FontSize="12" Foreground="{StaticResource V4TextSecondaryBrush}"/></StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Height="178" CornerRadius="8" Padding="11" Background="{StaticResource V4CardBackgroundBrush}" BorderBrush="{StaticResource V4CardStrokeBrush}" BorderThickness="1">
                        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Background="{StaticResource V4PreviewBackgroundBrush}">
                                <Border Width="56" Height="24" Background="#F29C29" CornerRadius="7"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Spacing="3"><TextBlock x:Name="Rec2Title" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource V4TextStrongBrush}"/><TextBlock x:Name="Rec2Description" FontSize="12" Foreground="{StaticResource V4TextSecondaryBrush}"/></StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Height="178" CornerRadius="8" Padding="11" Background="{StaticResource V4CardBackgroundBrush}" BorderBrush="{StaticResource V4CardStrokeBrush}" BorderThickness="1">
                        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Background="{StaticResource V4PreviewBackgroundBrush}">
                                <Border Width="56" Height="24" Background="#59B063" CornerRadius="7"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Spacing="3"><TextBlock x:Name="Rec3Title" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource V4TextStrongBrush}"/><TextBlock x:Name="Rec3Description" FontSize="12" Foreground="{StaticResource V4TextSecondaryBrush}"/></StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Height="178" CornerRadius="8" Padding="11" Background="{StaticResource V4CardBackgroundBrush}" BorderBrush="{StaticResource V4CardStrokeBrush}" BorderThickness="1">
                        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Background="{StaticResource V4PreviewBackgroundBrush}">
                                <Border Width="56" Height="24" Background="#9E54DB" CornerRadius="7"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/>
                                <Border Width="34" Height="10" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Spacing="3"><TextBlock x:Name="Rec4Title" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource V4TextStrongBrush}"/><TextBlock x:Name="Rec4Description" FontSize="12" Foreground="{StaticResource V4TextSecondaryBrush}"/></StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
