<Page x:Class="MindCanvas.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Padding="34,24" ColumnSpacing="30"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ListView x:Name="SettingsCategories" SelectionChanged="SettingsCategories_SelectionChanged" SelectedIndex="0"><x:String>General</x:String><x:String>Language &amp; region</x:String><x:String>Appearance</x:String><x:String>Editing</x:String><x:String>Files</x:String><x:String>Export</x:String><x:String>About</x:String></ListView>
<ScrollViewer Grid.Column="1"><StackPanel x:Name="SettingsContent" Spacing="12"><TextBlock x:Name="SettingsSectionTitle" Text="General" Style="{ThemeResource TitleTextBlockStyle}"/><Border Style="{StaticResource SettingsCardStyle}"/><Border CornerRadius="8" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Uid="SettingAutosave" FontWeight="SemiBold"/><TextBlock x:Uid="SettingAutosaveDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel><ToggleSwitch Grid.Column="1" IsOn="True"/></Grid></Border><Border CornerRadius="8" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Uid="SettingRestoreSession" FontWeight="SemiBold"/><TextBlock x:Uid="SettingRestoreSessionDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel><ToggleSwitch Grid.Column="1" IsOn="True"/></Grid></Border><Border x:Name="UpdateCard" CornerRadius="8" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="UpdateTitle" Text="MindCanvas" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatus" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel><Button x:Name="CheckUpdateButton" Grid.Column="1" x:Uid="SettingCheckUpdates" Click="CheckUpdateButton_Click"/></Grid></Border></StackPanel></ScrollViewer>
</Grid></Page>
