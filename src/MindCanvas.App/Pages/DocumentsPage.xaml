<Page
    x:Class="MindCanvas.Pages.DocumentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <DataTemplate x:Key="RecentDocumentCardTemplate">
            <Border
                Width="442"
                Height="72"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="8"
                Padding="16,12"
                Tag="{Binding Path}"
                Tapped="DocumentCard_Tapped"
                RightTapped="DocumentCard_RightTapped"
                Background="{ThemeResource V4CardBackgroundBrush}"
                BorderBrush="{ThemeResource V4CardStrokeBrush}"
                BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding AccentBrush}" CornerRadius="2" Margin="-16,-12,0,-12"/>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{ThemeResource V4AccentSubtleBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="◇" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource V4AccentForegroundBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource V4TextStrongBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{ThemeResource V4TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="›" FontSize="18" Foreground="{ThemeResource V4TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="34,34,50,40" ColumnSpacing="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Height="624" VerticalAlignment="Top" CornerRadius="8" Padding="12"
                    Background="{ThemeResource V4ContextActionsBackgroundBrush}">
                <StackPanel x:Name="FolderListPanel" Spacing="8">
                    <TextBlock x:Name="FoldersHeading" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource V4TextStrongBrush}" Margin="6,4,0,2"/>
                    <Button x:Name="AllDocumentsButton" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                    <Button x:Name="GraduationFolderButton" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                    <Button x:Name="ResearchFolderButton" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                    <Button x:Name="StudyFolderButton" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                    <StackPanel x:Name="CustomFoldersPanel" Spacing="8"/>
                    <Button x:Name="NewFolderButton" Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,10,0,0" Background="{ThemeResource V4ControlBackgroundBrush}" BorderBrush="{ThemeResource V4DividerStrongBrush}" Foreground="{ThemeResource V4TextStrongBrush}"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Spacing="12" MaxWidth="912" HorizontalAlignment="Left">
                <TextBlock x:Name="FolderTitle" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource V4TextStrongBrush}"/>
                <TextBlock x:Name="FolderMeta" FontSize="13" Foreground="{ThemeResource V4TextMutedBrush}" Margin="0,-6,0,12"/>

                <ItemsControl
                    x:Name="DocumentsItems"
                    Width="912"
                    HorizontalAlignment="Left"
                    ItemTemplate="{StaticResource RecentDocumentCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="456" ItemHeight="112"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Border x:Name="EmptyDocumentsCard" Height="128" CornerRadius="8" Padding="22" Visibility="Collapsed"
                        Background="{ThemeResource V4CardBackgroundBrush}" BorderBrush="{ThemeResource V4CardStrokeBrush}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                        <TextBlock x:Name="EmptyDocumentsTitle" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource V4TextStrongBrush}"/>
                        <TextBlock x:Name="EmptyDocumentsBody" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource V4TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Height="154" CornerRadius="8" Padding="18" Margin="0,14,0,0" Background="{ThemeResource V4CardBackgroundBrush}" BorderBrush="{ThemeResource V4CardStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="LocalDocumentsTitle" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource V4TextStrongBrush}"/>
                        <TextBlock x:Name="LocalDocumentsDescription" FontSize="13" Foreground="{ThemeResource V4TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="16" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ProgressBar x:Name="RecentIndexProgress" Value="0" Maximum="20" Height="10"/>
                            <TextBlock x:Name="StorageUsageText" Grid.Column="1" FontSize="13" Foreground="{ThemeResource V4TextSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
