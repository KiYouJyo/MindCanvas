<Page
    x:Class="MindCanvas.Pages.DocumentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid Padding="33,30,33,40" ColumnSpacing="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Height="624"
                    VerticalAlignment="Top"
                    CornerRadius="8"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="FoldersHeading" FontSize="16" FontWeight="SemiBold" Margin="6,4,0,2"/>
                    <Button x:Name="AllDocumentsButton" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                    <ToggleButton x:Name="GraduationFolderButton" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsChecked="True"/>
                    <Button x:Name="ResearchFolderButton" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                    <Button x:Name="StudyFolderButton" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                    <Button x:Name="NewFolderButton" Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Spacing="12" MaxWidth="912" HorizontalAlignment="Left">
                <TextBlock x:Name="FolderTitle" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="FolderMeta" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-6,0,12"/>

                <Grid ColumnSpacing="28" RowSpacing="40">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="72"/><RowDefinition Height="72"/></Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" CornerRadius="8" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Border Background="#0078D4" CornerRadius="2" Margin="-16,-12,0,-12"/><Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#1A0078D4" HorizontalAlignment="Center"/><StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="Doc1Title" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="Doc1Meta" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="3" Text="⋯" FontSize="18" VerticalAlignment="Center"/></Grid>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" CornerRadius="8" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Border Background="#59B063" CornerRadius="2" Margin="-16,-12,0,-12"/><Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#1A0078D4" HorizontalAlignment="Center"/><StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="Doc2Title" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="Doc2Meta" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="3" Text="⋯" FontSize="18" VerticalAlignment="Center"/></Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" CornerRadius="8" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Border Background="#F29C29" CornerRadius="2" Margin="-16,-12,0,-12"/><Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#1A0078D4" HorizontalAlignment="Center"/><StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="Doc3Title" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="Doc3Meta" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="3" Text="⋯" FontSize="18" VerticalAlignment="Center"/></Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" CornerRadius="8" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Border Background="#9E54DB" CornerRadius="2" Margin="-16,-12,0,-12"/><Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#1A0078D4" HorizontalAlignment="Center"/><StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="Doc4Title" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="Doc4Meta" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="3" Text="⋯" FontSize="18" VerticalAlignment="Center"/></Grid>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" CornerRadius="8" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Border Background="#0078D4" CornerRadius="2" Margin="-16,-12,0,-12"/><Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#1A0078D4" HorizontalAlignment="Center"/><StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="Doc5Title" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="Doc5Meta" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="3" Text="⋯" FontSize="18" VerticalAlignment="Center"/></Grid>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" CornerRadius="8" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Border Background="#59B063" CornerRadius="2" Margin="-16,-12,0,-12"/><Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#1A0078D4" HorizontalAlignment="Center"/><StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="Doc6Title" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="Doc6Meta" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="3" Text="⋯" FontSize="18" VerticalAlignment="Center"/></Grid>
                    </Border>
                </Grid>

                <Border Height="154" CornerRadius="8" Padding="18" Margin="0,14,0,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="LocalDocumentsTitle" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LocalDocumentsDescription" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid ColumnSpacing="16" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ProgressBar Value="31" Maximum="100" Height="10"/>
                            <TextBlock x:Name="StorageUsageText" Grid.Column="1" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
