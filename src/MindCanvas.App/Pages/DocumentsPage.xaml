<Page x:Class="MindCanvas.Pages.DocumentsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Padding="34,24" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="12"><StackPanel Spacing="6"><TextBlock x:Uid="DocumentsFolders" FontWeight="SemiBold" Margin="8"/><Button x:Uid="DocumentsAll" HorizontalAlignment="Stretch"/><Button Content="Graduation project" HorizontalAlignment="Stretch"/><Button Content="Research" HorizontalAlignment="Stretch"/><Button Content="Study notes" HorizontalAlignment="Stretch"/><Button x:Uid="DocumentsNewFolder" HorizontalAlignment="Stretch" Margin="0,10,0,0"/></StackPanel></Border>
<StackPanel Grid.Column="1" Spacing="12"><TextBlock x:Uid="DocumentsTitle" Style="{ThemeResource TitleTextBlockStyle}"/><TextBox x:Uid="DocumentsSearch" Width="380" HorizontalAlignment="Left"/><ItemsRepeater><ItemsRepeater.ItemsSource><x:Array Type="x:String"><x:String>Product launch plan</x:String><x:String>Research plan</x:String><x:String>Portfolio structure</x:String><x:String>Design concepts</x:String></x:Array></ItemsRepeater.ItemsSource><ItemsRepeater.ItemTemplate><DataTemplate><Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16" Margin="0,4"><TextBlock Text="{Binding}" FontWeight="SemiBold"/></Border></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater></StackPanel>
</Grid></Page>
