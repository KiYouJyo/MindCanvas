<Page
    x:Class="MindCanvas.Pages.TemplatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="33,26,33,40" Spacing="34" MaxWidth="1224" HorizontalAlignment="Left">
            <StackPanel Spacing="10">
                <TextBlock x:Name="FavoritesHeading" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="FavoritesDescription" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-4,0,2"/>
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="190" CornerRadius="8" Padding="11" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Border Width="56" Height="24" Background="#0078D4" CornerRadius="7"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/></Grid><StackPanel Grid.Row="1" Spacing="3"><Grid><TextBlock x:Name="Fav1Title" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="★" HorizontalAlignment="Right" Foreground="#EB9C14"/></Grid><TextBlock x:Name="Fav1Category" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                    </Border>
                    <Border Grid.Column="1" Height="190" CornerRadius="8" Padding="11" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Border Width="56" Height="24" Background="#59B063" CornerRadius="7"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/></Grid><StackPanel Grid.Row="1" Spacing="3"><Grid><TextBlock x:Name="Fav2Title" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="★" HorizontalAlignment="Right" Foreground="#EB9C14"/></Grid><TextBlock x:Name="Fav2Category" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                    </Border>
                    <Border Grid.Column="2" Height="190" CornerRadius="8" Padding="11" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Border Width="56" Height="24" Background="#F29C29" CornerRadius="7"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/></Grid><StackPanel Grid.Row="1" Spacing="3"><Grid><TextBlock x:Name="Fav3Title" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="★" HorizontalAlignment="Right" Foreground="#EB9C14"/></Grid><TextBlock x:Name="Fav3Category" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                    </Border>
                    <Border Grid.Column="3" Height="190" CornerRadius="8" Padding="11" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Border Width="56" Height="24" Background="#9E54DB" CornerRadius="7"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/></Grid><StackPanel Grid.Row="1" Spacing="3"><Grid><TextBlock x:Name="Fav4Title" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="★" HorizontalAlignment="Right" Foreground="#EB9C14"/></Grid><TextBlock x:Name="Fav4Category" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="14">
                <TextBlock x:Name="BrowseHeading" FontSize="20" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ToggleButton x:Name="BrowseAll" Width="108" Height="34" IsChecked="True"/>
                    <ToggleButton x:Name="BrowseMindMap" Width="108" Height="34"/>
                    <ToggleButton x:Name="BrowseProject" Width="108" Height="34"/>
                    <ToggleButton x:Name="BrowseStudy" Width="108" Height="34"/>
                    <ToggleButton x:Name="BrowseResearch" Width="108" Height="34"/>
                </StackPanel>
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="190" CornerRadius="8" Padding="11" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Border Width="56" Height="24" Background="#0078D4" CornerRadius="7"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/></Grid><StackPanel Grid.Row="1" Spacing="3"><TextBlock x:Name="Browse1Title" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="Browse1Category" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                    </Border>
                    <Border Grid.Column="1" Height="190" CornerRadius="8" Padding="11" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Border Width="56" Height="24" Background="#F29C29" CornerRadius="7"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/></Grid><StackPanel Grid.Row="1" Spacing="3"><TextBlock x:Name="Browse2Title" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="Browse2Category" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                    </Border>
                    <Border Grid.Column="2" Height="190" CornerRadius="8" Padding="11" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Border Width="56" Height="24" Background="#59B063" CornerRadius="7"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/></Grid><StackPanel Grid.Row="1" Spacing="3"><TextBlock x:Name="Browse3Title" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="Browse3Category" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                    </Border>
                    <Border Grid.Column="3" Height="190" CornerRadius="8" Padding="11" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Border Width="56" Height="24" Background="#9E54DB" CornerRadius="7"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0"/><Border Width="34" Height="10" Background="#C7CFD6" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/></Grid><StackPanel Grid.Row="1" Spacing="3"><TextBlock x:Name="Browse4Title" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="Browse4Category" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
