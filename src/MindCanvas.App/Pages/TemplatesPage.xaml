<Page x:Class="MindCanvas.Pages.TemplatesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer><StackPanel Padding="34,24" Spacing="18"><StackPanel Orientation="Horizontal" Spacing="8"><ToggleButton x:Uid="TemplatesRecommended" IsChecked="True"/><ToggleButton x:Uid="TemplatesAll"/><ToggleButton x:Uid="TemplatesFavorites"/><TextBox x:Uid="TemplatesSearch" Width="320" Margin="24,0,0,0"/></StackPanel><Grid ColumnSpacing="14" RowSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition Height="180"/></Grid.RowDefinitions>
<Border Grid.Row="0" Grid.Column="0" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16"><TextBlock x:Uid="TemplateProject" FontWeight="SemiBold" VerticalAlignment="Bottom"/></Border><Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16"><TextBlock Text="SWOT" FontWeight="SemiBold" VerticalAlignment="Bottom"/></Border><Border Grid.Column="2" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16"><TextBlock x:Uid="TemplateResearch" FontWeight="SemiBold" VerticalAlignment="Bottom"/></Border><Border Grid.Column="3" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16"><TextBlock x:Uid="TemplateCourse" FontWeight="SemiBold" VerticalAlignment="Bottom"/></Border></Grid></StackPanel></ScrollViewer></Page>
