<Page x:Class="MindCanvas.Pages.EditorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
<Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="18"><StackPanel><TextBlock x:Uid="EditorOutline" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBox x:Uid="EditorSearch" Margin="0,12"/><TreeView x:Name="OutlineTree"/></StackPanel></Border>
<ScrollViewer Grid.Column="1" HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled"><Canvas x:Name="MapCanvas" Width="1600" Height="1000" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"/></ScrollViewer>
<Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="16"><StackPanel Spacing="12"><TextBlock x:Uid="EditorFormat" Style="{ThemeResource SubtitleTextBlockStyle}"/><StackPanel Orientation="Horizontal" Spacing="8"><ToggleButton x:Uid="EditorStructure" IsChecked="True"/><ToggleButton x:Uid="EditorTheme"/></StackPanel><TextBlock x:Uid="EditorCurrentTemplate" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Border CornerRadius="8" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><TextBlock x:Uid="TemplateProject" FontWeight="SemiBold"/></Border></StackPanel></Border>
</Grid></Page>
