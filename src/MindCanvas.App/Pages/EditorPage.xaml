<Page
    x:Class="MindCanvas.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid x:Name="EditorRoot" Background="{StaticResource V4WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="OutlineColumn" Width="306" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="FormatColumn" Width="260" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="NarrowOutlinePane"
            Grid.Column="0"
            Background="{StaticResource V4ContextActionsBackgroundBrush}"
            BorderBrush="{StaticResource V4DividerStrongBrush}"
            BorderThickness="0,0,1,0"
            Padding="14,18,14,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="OutlinePaneTitle" FontSize="20" FontWeight="Medium" Foreground="{StaticResource V4TextStrongBrush}" />
                    <TextBlock Text="⋯" FontSize="22" HorizontalAlignment="Right" Foreground="{StaticResource V4TextSecondaryBrush}" />
                </Grid>
                <TextBox
                    x:Name="OutlineSearch"
                    Grid.Row="1"
                    Margin="0,12,0,12"
                    Height="38"
                    Background="{StaticResource V4ControlBackgroundBrush}"
                    BorderBrush="{StaticResource V4ControlStrokeBrush}" />
                <controls:TreeView
                    x:Name="OutlineTree"
                    Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionMode="Single" />
                <Button
                    x:Name="OutlineAddTopicButton"
                    Grid.Row="3"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    Padding="0,10,0,14"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource V4TextStrongBrush}" />
            </Grid>
        </Border>

        <Border
            x:Name="WideOutlinePane"
            Grid.Column="1"
            Background="{StaticResource V4WindowBackgroundBrush}"
            Visibility="Collapsed">
            <Grid Padding="22,22,22,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="WideOutlineTitle" FontSize="24" FontWeight="Bold" Foreground="{StaticResource V4TextStrongBrush}" />
                    <TextBlock x:Name="WideOutlineCount" FontSize="12" Foreground="{StaticResource V4TextMutedBrush}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="WideOutlineSearch"
                        Width="520"
                        Height="38"
                        HorizontalAlignment="Left"
                        Background="{StaticResource V4ControlBackgroundBrush}"
                        BorderBrush="{StaticResource V4ControlStrokeBrush}" />
                    <Border
                        Grid.Column="1"
                        Width="264"
                        Height="38"
                        BorderBrush="{StaticResource V4DividerStrongBrush}"
                        BorderThickness="1"
                        Background="{StaticResource V4ControlBackgroundBrush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="WideOutlineDensityLabel" FontSize="13" Foreground="{StaticResource V4TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Button x:Name="CompactDensityButton" Height="30" MinWidth="70" Background="{StaticResource V4ControlSelectedBackgroundBrush}" Foreground="{StaticResource V4AccentForegroundBrush}" />
                            <Button x:Name="ComfortableDensityButton" Height="30" MinWidth="74" Background="{StaticResource V4ControlBackgroundBrush}" Foreground="{StaticResource V4TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="116" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="WideOutlineTopicHeader" FontSize="12" FontWeight="Bold" Foreground="{StaticResource V4TextSecondaryBrush}" />
                    <TextBlock x:Name="WideOutlineNoteHeader" Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="{StaticResource V4TextSecondaryBrush}" />
                    <TextBlock x:Name="WideOutlineStatusHeader" Grid.Column="2" FontSize="12" FontWeight="Bold" Foreground="{StaticResource V4TextMutedBrush}" />
                    <Border Grid.Column="0" Grid.ColumnSpan="3" Height="1" Margin="0,8,0,0" Background="{StaticResource V4DividerStrongBrush}" VerticalAlignment="Bottom" />
                </Grid>

                <ScrollViewer Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="WideOutlineRows" Spacing="10" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid x:Name="MapHost" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>
            <ScrollViewer
                x:Name="MapScrollViewer"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Enabled"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                ZoomMode="Enabled">
                <Canvas
                    x:Name="MapCanvas"
                    Width="1600"
                    Height="1000"
                    Background="{StaticResource V4CardBackgroundBrush}" />
            </ScrollViewer>
            <Border
                Grid.Row="1"
                Background="{StaticResource V4ContextActionsBackgroundBrush}"
                BorderBrush="{StaticResource V4CanvasGridLineBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,0">
                <Grid>
                    <TextBlock x:Name="MapStatusText" FontSize="11" Foreground="{StaticResource V4TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="−   100%   ＋" FontSize="11" HorizontalAlignment="Right" Foreground="{StaticResource V4TextSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <Border
            x:Name="FormatPanel"
            Grid.Column="2"
            Background="{StaticResource V4ContextActionsBackgroundBrush}"
            BorderBrush="{StaticResource V4DividerStrongBrush}"
            BorderThickness="1,0,0,0"
            Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock x:Name="FormatPanelTitle" FontSize="20" FontWeight="Medium" Foreground="{StaticResource V4TextStrongBrush}" />
                        <Button x:Name="CollapseFormatButton" Width="32" Height="32" HorizontalAlignment="Right" Background="{StaticResource V4ControlBackgroundBrush}" BorderBrush="{StaticResource V4ControlStrokeBrush}" Foreground="{StaticResource V4TextSecondaryBrush}" Click="CollapseFormatButton_Click" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ToggleButton x:Name="StructureTabButton" Width="108" Height="34" IsChecked="True" Background="{StaticResource V4ControlSelectedBackgroundBrush}" BorderBrush="{StaticResource V4ControlSelectedStrokeBrush}" Foreground="{StaticResource V4AccentForegroundBrush}" />
                        <ToggleButton x:Name="ThemeTabButton" Width="108" Height="34" Background="{StaticResource V4ControlBackgroundBrush}" BorderBrush="{StaticResource V4ControlStrokeBrush}" Foreground="{StaticResource V4TextPrimaryBrush}" />
                    </StackPanel>

                    <TextBlock x:Name="CurrentTemplateLabel" FontSize="12" FontWeight="Medium" Foreground="{StaticResource V4TextSecondaryBrush}" />
                    <Border
                        Height="86"
                        CornerRadius="8"
                        Padding="12"
                        Background="{StaticResource V4CardBackgroundBrush}"
                        BorderBrush="{StaticResource V4CardStrokeBrush}"
                        BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="42"
                                Height="34"
                                CornerRadius="4"
                                Background="{StaticResource V4StatusProgressBackgroundBrush}"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="CurrentTemplateName" FontSize="13" FontWeight="Medium" Foreground="{StaticResource V4TextStrongBrush}" />
                                <TextBlock x:Name="CurrentTemplateHint" FontSize="11" Foreground="{StaticResource V4TextSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="ChangeTemplateButton" Grid.Column="2" MinWidth="50" Height="34" VerticalAlignment="Center" Background="{StaticResource V4ControlBackgroundBrush}" BorderBrush="{StaticResource V4DividerStrongBrush}" Foreground="{StaticResource V4TextStrongBrush}" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="StructureLabel" FontSize="12" FontWeight="Medium" Foreground="{StaticResource V4TextSecondaryBrush}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="66" />
                            <RowDefinition Height="66" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" CornerRadius="6" Background="{StaticResource V4CardBackgroundBrush}" BorderBrush="{StaticResource V4ControlSelectedStrokeBrush}" BorderThickness="1">
                            <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="36" Height="18" Background="{StaticResource V4NodeAccentBlueBrush}" CornerRadius="3" />
                                <TextBlock x:Name="StructureMindMapText" FontSize="10" Foreground="{StaticResource V4AccentStrongBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" CornerRadius="6" Background="{StaticResource V4CardBackgroundBrush}" BorderBrush="{StaticResource V4ControlStrokeBrush}" BorderThickness="1">
                            <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="36" Height="18" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="3" />
                                <TextBlock x:Name="StructureLogicText" FontSize="10" Foreground="{StaticResource V4TextStrongBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" CornerRadius="6" Background="{StaticResource V4CardBackgroundBrush}" BorderBrush="{StaticResource V4ControlStrokeBrush}" BorderThickness="1">
                            <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="36" Height="18" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="3" />
                                <TextBlock x:Name="StructureTreeText" FontSize="10" Foreground="{StaticResource V4TextStrongBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="6" Background="{StaticResource V4CardBackgroundBrush}" BorderBrush="{StaticResource V4ControlStrokeBrush}" BorderThickness="1">
                            <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="36" Height="18" Background="{StaticResource V4PreviewBranchBrush}" CornerRadius="3" />
                                <TextBlock x:Name="StructureOrgText" FontSize="10" Foreground="{StaticResource V4TextStrongBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="ThemeLabel" FontSize="12" FontWeight="Medium" Foreground="{StaticResource V4TextSecondaryBrush}" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="6" Background="{StaticResource V4CardBackgroundBrush}" BorderBrush="{StaticResource V4ControlStrokeBrush}" BorderThickness="1">
                            <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="4">
                                <Border Width="40" Height="30" Background="#EBF5FF" />
                                <TextBlock x:Name="ThemeFluentText" FontSize="9" Foreground="{StaticResource V4TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="6" Background="{StaticResource V4CardBackgroundBrush}" BorderBrush="{StaticResource V4ControlStrokeBrush}" BorderThickness="1">
                            <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="4">
                                <Border Width="40" Height="30" Background="#FFEBF0" />
                                <TextBlock x:Name="ThemeSoftText" FontSize="9" Foreground="{StaticResource V4TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="6" Background="{StaticResource V4CardBackgroundBrush}" BorderBrush="{StaticResource V4ControlStrokeBrush}" BorderThickness="1">
                            <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="4">
                                <Border Width="40" Height="30" Background="#EDEDED" />
                                <TextBlock x:Name="ThemeMonoText" FontSize="9" Foreground="{StaticResource V4TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" CornerRadius="6" Background="{StaticResource V4CardBackgroundBrush}" BorderBrush="{StaticResource V4ControlStrokeBrush}" BorderThickness="1">
                            <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="4">
                                <Border Width="40" Height="30" Background="#2E2E30" />
                                <TextBlock x:Name="ThemeDarkText" FontSize="9" Foreground="{StaticResource V4TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="FormatPanelHint" FontSize="10" Foreground="{StaticResource V4TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
