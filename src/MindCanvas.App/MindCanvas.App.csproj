<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>MindCanvas</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8016" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MindCanvas.Core/MindCanvas.Core.csproj" />
    <ProjectReference Include="../MindCanvas.Layout/MindCanvas.Layout.csproj" />
    <ProjectReference Include="../MindCanvas.Storage/MindCanvas.Storage.csproj" />
    <ProjectReference Include="../MindCanvas.Update/MindCanvas.Update.csproj" />
  </ItemGroup>
  <Target Name="GeneratePlaceholderAssets" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\eng\Generate-PlaceholderAssets.ps1&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)\Assets\Generated&quot;" />
  </Target>
</Project>
